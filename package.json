{
  "name": "openclaw-home-assistant-events",
  "version": "0.1.3",
  "description": "Persistent agent-owned Home Assistant event subscriptions for OpenClaw",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mstberto/openclaw-home-assistant-events.git"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "skills",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "build": {
      "openclawVersion": "2026.9.9",
      "pluginSdkVersion": "2026.9.9"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "test:smoke": "node scripts/smoke.mjs",
    "test:activation": "node scripts/smoke.mjs --activation"
  },
  "peerDependencies": {
    "openclaw": "2026.9.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.5.0",
    "openclaw": "2026.9.9",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  }
}
